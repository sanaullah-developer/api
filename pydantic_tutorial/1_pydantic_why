from pydantic import BaseModel, Field
from typing import List, Dict
class Patient(BaseModel):
    name: str
    age: int = Field(gt=0, lt=120)  # must be > 0 and < 120
    weight: float
    married: bool
    allergies: List[str]
    contact_details: Dict[str,str]

def insert_patient_data(patient: Patient):
    print(patient.name)
    print(patient.age)
    print("inserted into database")

# Usage:
patient1 = Patient(name="sanaullah", age=30, weight=70, married=False, allergies=['pollen','dust'], contact={'email':'abc@gmail.com'} )   # works fine
insert_patient_data(patient1)

patient2 = Patient(name="sanaullah", age="thirty")  # raises ValidationError automatically